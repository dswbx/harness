{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harness",
  "version": "0.1.0",
  "identifier": "dev.dswbx.harness",
  "build": {
    "beforeDevCommand": {
      "script": "bun run dev",
      "cwd": "../../app"
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "bun run build",
      "cwd": "../../app"
    },
    "frontendDist": "../../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Harness",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 26 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Desktop host for ACP agents",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3RjNGRTVEQjc2RUYyNTcKUldSWDhtNjNYZjd6bDBjQUJoL0o0bjJucHBXQW9tQzhManVKSmlGM1hYOE55UVljandJUnpiUncK",
      "endpoints": [
        "https://github.com/dswbx/harness/releases/latest/download/latest.json"
      ]
    }
  }
}
