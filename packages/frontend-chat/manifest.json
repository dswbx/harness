                              "$ref": "#/$defs/expr"
                            }
                          ]
                        },
                        "gap": {
                          "anyOf": [
                            {
                              "type": "string",
                              "enum": [
                                "sm",
                                "md",
                                "lg"
                              ]
                            },
                            {
                              "$ref": "#/$defs/expr"
                            }
                          ]
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "Card"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "props": {
                      "type": "object",
                      "properties": {
                        "title": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "$ref": "#/$defs/expr"
                            }
                          ]
                        },
                        "tone": {
                          "anyOf": [
                            {
                              "type": "string",
                              "description": "Accent. Default neutral.",
                              "enum": [
                                "neutral",
                                "info",
                                "success",
                                "warning",
                                "error"
                              ]
                            },
                            {
                              "$ref": "#/$defs/expr"
                            }
                          ]
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "Markdown"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "props": {
                      "type": "object",
                      "properties": {
                        "text": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "$ref": "#/$defs/expr"
                            }
                          ]
                        }
                      },
                      "required": [
                        "text"
                      ],
                      "additionalProperties": false
                    },
                    "children": {
                      "maxItems": 0
                    }
                  },
                  "required": [
                    "props"
                  ]
                }
              },
