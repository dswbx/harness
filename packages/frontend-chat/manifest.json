                          "anyOf": [
                            {
                              "type": "string",
                              "enum": [
                                "vertical",
                                "horizontal"
                              ]
                            },
                            {
                              "$ref": "#/$defs/expr"
                            }
                          ]
                        },
                        "gap": {
                          "anyOf": [
                            {
                              "type": "string",
                              "enum": [
                                "sm",
                                "md",
                                "lg"
                              ]
                            },
                            {
                              "$ref": "#/$defs/expr"
                            }
                          ]
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
