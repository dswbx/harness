                          "anyOf": [
                            {
                              "type": "array",
                              "items": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              }
                            },
                            {
                              "$ref": "#/$defs/expr"
                            }
                          ]
                        }
                      },
                      "required": [
                        "columns",
                        "rows"
                      ],
                      "additionalProperties": false
                    },
                    "children": {
                      "maxItems": 0
                    }
                  },
                  "required": [
                    "props"
                  ]
