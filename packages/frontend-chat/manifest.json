                            {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            {
                              "$ref": "#/$defs/expr"
                            }
                          ]
                        },
                        "rows": {
                          "anyOf": [
                            {
                              "type": "array",
                              "items": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              }
                            },
                            {
                              "$ref": "#/$defs/expr"
                            }
                          ]
                        }
                      },
                      "required": [
                        "columns",
                        "rows"
                      ],
