[
   {
      "name": "add creates missing parents",
      "doc": {},
      "ops": [{ "op": "add", "path": "/a/b/c", "value": 1 }],
      "expect": { "a": { "b": { "c": 1 } } }
   },
   {
      "name": "add at an array index inserts, - appends",
      "doc": { "l": ["x", "z"] },
      "ops": [
         { "op": "add", "path": "/l/1", "value": "y" },
         { "op": "add", "path": "/l/-", "value": "w" }
      ],
      "expect": { "l": ["x", "y", "z", "w"] }
   },
   {
      "name": "replace at an index sets it, at the length appends",
      "doc": { "r": [null, null] },
      "ops": [
         { "op": "replace", "path": "/r/0", "value": true },
         { "op": "replace", "path": "/r/2", "value": false }
      ],
      "expect": { "r": [true, null, false] }
   },
   {
      "name": "replace creates a missing key",
      "doc": { "a": 1 },
      "ops": [{ "op": "replace", "path": "/b", "value": 2 }],
      "expect": { "a": 1, "b": 2 }
   },
   {
      "name": "pointer escapes ~1 and ~0",
      "doc": {},
      "ops": [
         { "op": "replace", "path": "/a~1b", "value": 1 },
         { "op": "replace", "path": "/c~0d", "value": 2 }
      ],
      "expect": { "a/b": 1, "c~d": 2 }
   },
   {
      "name": "remove key, index, and a missing path (no-op)",
      "doc": { "o": { "k": 1, "j": 2 }, "l": [1, 2, 3] },
      "ops": [
         { "op": "remove", "path": "/o/k" },
         { "op": "remove", "path": "/l/1" },
         { "op": "remove", "path": "/missing/x" },
         { "op": "remove", "path": "/l/9" }
      ],
      "expect": { "o": { "j": 2 }, "l": [1, 3] }
   },
   {
      "name": "empty path replaces the whole document, remove of it empties it",
      "doc": { "a": 1 },
      "ops": [{ "op": "replace", "path": "", "value": [1] }],
      "expect": [1]
   },
   {
      "name": "remove of the root gives an empty object",
      "doc": { "a": 1 },
      "ops": [{ "op": "remove", "path": "" }],
      "expect": {}
   },
   {
      "name": "null parent becomes an object",
      "doc": { "a": null },
      "ops": [{ "op": "add", "path": "/a/b", "value": 1 }],
      "expect": { "a": { "b": 1 } }
   },
   {
      "name": "test passes on an equal value",
      "doc": { "a": { "b": [1, 2] } },
      "ops": [{ "op": "test", "path": "/a/b", "value": [1, 2] }],
      "expect": { "a": { "b": [1, 2] } }
   },
   {
      "name": "test fails on a different value, nothing applies",
      "doc": { "a": 1 },
      "ops": [
         { "op": "replace", "path": "/a", "value": 5 },
         { "op": "test", "path": "/a", "value": 1 }
      ],
      "error": "test failed"
   },
   {
      "name": "test of a missing path fails",
      "doc": {},
      "ops": [{ "op": "test", "path": "/a", "value": null }],
      "error": "test failed"
   },
   {
      "name": "path without a leading slash fails",
      "doc": {},
      "ops": [{ "op": "add", "path": "quiz", "value": 1 }],
      "error": "starts with /"
   },
   {
      "name": "add inside a scalar fails",
      "doc": { "a": 1 },
      "ops": [{ "op": "add", "path": "/a/x", "value": 1 }],
      "error": "not an object or array"
   },
   {
      "name": "array index out of range fails",
      "doc": { "a": [1] },
      "ops": [{ "op": "replace", "path": "/a/3", "value": 1 }],
      "error": "out of range"
   },
   {
      "name": "array parent index out of range fails",
      "doc": { "a": [1] },
      "ops": [{ "op": "add", "path": "/a/3/x", "value": 1 }],
      "error": "is not an index"
   },
   {
      "name": "test compares objects regardless of key order",
      "doc": { "a": { "x": 1, "y": 2 } },
      "ops": [{ "op": "test", "path": "/a", "value": { "y": 2, "x": 1 } }],
      "expect": { "a": { "x": 1, "y": 2 } }
   },
   {
      "name": "test ignores key order in nested objects",
      "doc": { "a": { "x": { "p": 1, "q": [1, { "m": 1, "n": 2 }] }, "y": 2 } },
      "ops": [
         {
            "op": "test",
            "path": "/a",
            "value": { "y": 2, "x": { "q": [1, { "n": 2, "m": 1 }], "p": 1 } }
         }
      ],
      "expect": { "a": { "x": { "p": 1, "q": [1, { "m": 1, "n": 2 }] }, "y": 2 } }
   },
   {
      "name": "test keeps array order",
      "doc": { "a": [1, 2] },
      "ops": [{ "op": "test", "path": "/a", "value": [2, 1] }],
      "error": "test failed"
   },
   {
      "name": "test fails on a different key set",
      "doc": { "a": { "x": 1 } },
      "ops": [{ "op": "test", "path": "/a", "value": { "x": 1, "y": 1 } }],
      "error": "test failed"
   }
]
