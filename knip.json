{
   "$schema": "https://unpkg.com/knip@6/schema.json",
   "workspaces": {
      ".": {
         "entry": ["scripts/*.ts"],
         "project": ["scripts/**/*.ts"],
         "ignore": ["**/*.test.ts"]
      },
      "app": {
         "ignore": ["**/*.test.ts"]
      },
      "packages/*": {
         "project": ["src/**/*.{ts,tsx}"],
         "ignore": ["**/*.test.ts"],
         "ignoreDependencies": ["@lexical/headless", "remark-parse", "remark-rehype", "unified"]
      },
      "packages/ui": {
         "project": ["src/**/*.{ts,tsx}"],
         "ignore": ["**/*.test.ts"],
         "ignoreIssues": { "src/components/**": ["exports", "types"] }
      }
   },
   "vitest": false,
   "ignoreExportsUsedInFile": true,
   "tags": ["-internal"],
   "ignoreUnresolved": ["vite/client"]
}
